# Triggers etf-collector.service Mon-Fri at 08:00 Hong Kong time.
# (Server timezone is set to Asia/Hong_Kong by deploy/setup.sh, so this is local 08:00.)
# At 08:00 HKT the market hasn't opened yet, so it fetches the PREVIOUS trading day's
# full close — which by then is available for all 5 markets (incl. US overnight).
# Mon-Fri covers all 5 weekday closes (Friday's close is picked up Monday morning).
#
# Install: copy to /etc/systemd/system/etf-collector.timer
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now etf-collector.timer
# Check schedule:  systemctl list-timers etf-collector.timer

[Unit]
Description=Run ETF data collection Mon-Fri 08:00 HKT

[Timer]
# Mon..Fri at 08:00 server-local time (= HKT).
OnCalendar=Mon..Fri *-*-* 08:00:00
# If the server was off at trigger time, run as soon as it's back up
Persistent=true

[Install]
WantedBy=timers.target
