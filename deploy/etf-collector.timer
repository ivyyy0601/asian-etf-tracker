# Triggers etf-collector.service Mon–Fri at 07:00 Hong Kong time.
# The timezone is explicit in OnCalendar because the server clock itself is
# America/New_York (shared with the sentiment dashboard) — 07:00 HKT = 19:00 ET.
# At that hour the previous trading day's close is final for all 5 markets.
#
# Server path: /etc/systemd/system/etf-collector.timer
# Next run: systemctl list-timers etf-collector.timer

[Unit]
Description=ETF collection Mon-Fri 07:00 Hong Kong time

[Timer]
OnCalendar=Mon..Fri *-*-* 07:00:00 Asia/Hong_Kong
# If the server was off at trigger time, run as soon as it's back up
Persistent=true

[Install]
WantedBy=timers.target
